{
  "name": "@dshub/airpods-helper",
  "description": "macOS native helper: AirPods proximity, connections, connect card and press-to-talk capture",
  "version": "0.2.2-rc.1",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "bin/**/*",
    "assets/*.png"
  ],
  "scripts": {
    "build:native": "sh scripts/build.sh"
  },
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts"
}
