{
  "name": "@dshub/airpods-space-bundle",
  "description": "AirPods space: press your AirPods to talk to DSH, with live captions, battery card and local streaming recognition",
  "version": "0.2.2-rc.1",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "README.md",
    "README.zh.md",
    "cordis.patch.yml",
    "docs",
    "icon.svg",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "locale/*.json"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-experimental-speech-to-text": "workspace:*",
    "@deepseek-ai/dsh-experimental-speech-to-text-sensevoice": "workspace:*",
    "@deepseek-ai/dsh-experimental-api-speech-to-text": "workspace:*",
    "@deepseek-ai/dsh-experimental-client-ui-voice-input": "workspace:*",
    "@dshub/speech-streaming": "workspace:*",
    "@dshub/speech-streaming-sherpa": "workspace:*",
    "@dshub/airpods-space": "workspace:*",
    "@dshub/client-ui-airpods-space": "workspace:*",
    "@dshub/speech-streaming-aliyun": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "icon": "./icon.svg"
}
