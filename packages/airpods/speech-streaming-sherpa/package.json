{
  "name": "@dshub/speech-streaming-sherpa",
  "description": "Local streaming Paraformer (Chinese/English) recognition through sherpa-onnx in a dedicated process",
  "version": "0.2.2-rc.1",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/worker.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "runtime/assets.json"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~",
    "@deepseek-ai/dsh-timeout": "workspace:*",
    "sherpa-onnx-node": "1.13.8",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-experimental-speech-to-text": "workspace:*",
    "@deepseek-ai/dsh-subprocess": "workspace:*",
    "@dshub/speech-streaming": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-experimental-speech-to-text": "workspace:*",
    "@deepseek-ai/dsh-subprocess": "workspace:*",
    "@dshub/speech-streaming": "workspace:*",
    "@deepseek-ai/dsh-subprocess-local": "workspace:*"
  }
}
